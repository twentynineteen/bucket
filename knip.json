{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.tsx",
    "src/App.tsx",
    "tests/setup/vitest-setup.ts",
    "tests/setup/msw-server.ts",
    "src/**/*.test.{ts,tsx}",
    "tests/**/*.test.{ts,tsx}",
    "tests/utils/*.ts",
    "eslint.config.js",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}"],
  "ignore": ["**/*.generated.ts"],
  "ignoreDependencies": [
    "vite-plugin-monaco-editor",
    "@vitejs/plugin-react",
    "vite-tsconfig-paths",
    "eslint-import-resolver-typescript"
  ],
  "ignoreBinaries": ["dot"],
  "exclude": ["duplicates"],
  "vite": false,
  "vitest": false,
  "eslint": false
}
